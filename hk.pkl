amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

// Never pass build output, local captures, or secrets to checks.
exclude = List(
    ".omp/**",
    ".agents/**",
    "target/**",
    "dist/**",
    "macos/.build/**",
    "fnox.local.toml",
    "**/*.age",
    "**/age.txt"
)

// Fork-owned means not in upstream/main. docs/s8/upstream-files.sh writes the list of
// upstream's files; steps for fork-owned files take every file minus that list.
local upstream_files = read("docs/s8/upstream-files.txt").text.split("\n").filter((it) -> !it.isEmpty)
local upstream_markdown = upstream_files.filter((it) -> it.endsWith(".md"))
local upstream_files_check = new CommandSpec {
    command = new Command {
        argv = List("docs/s8/upstream-files.sh", "--check")
    }
    effect = "read"
}

// mdsmith lints every fork-owned note (.mdsmith.yml), not only the changed ones:
// a rename or a deletion breaks links and the index in notes the commit leaves alone.
local mdsmith_check = new CommandSpec {
    command = new Command {
        argv = List("mdsmith", "check", ".")
    }
    effect = "read"
}
// mdsmith fix, then the repo-markdown-fixer agent on what it cannot fix.
local mdsmith_fix = new CommandSpec {
    command = new Command {
        argv = List("docs/s8/mdsmith-fix.sh", ".")
    }
    effect = "write"
}
// hk pipes step output, so mdsmith colours it only when told to. NO_COLOR=1 still wins.
local mdsmith_env = new Mapping {
    ["FORCE_COLOR"] = "1"
}

steps {
    ["cargo_fmt"] = Builtins.cargo_fmt
    ["cargo_clippy"] {
        glob = List("**/*.rs", "Cargo.toml", "Cargo.lock")
        check = new CommandSpec {
            command = new Command {
                argv = List("cargo", "clippy", "--locked", "--all-targets", "--all-features", "--", "-D", "warnings")
            }
            effect = "read"
        }
    }
    ["plist_lint"] {
        glob = "**/*.plist"
        batch = true
        check = new CommandSpec {
            command = new Command {
                argv = List("plutil", "-lint", "{{files}}")
            }
            effect = "read"
        }
    }
    ["bash_syntax"] {
        glob = "**/*.sh"
        check = new CommandSpec {
            command = new Command {
                argv = List("bash", "-n", "{{files}}")
            }
            effect = "read"
        }
    }
    ["shellcheck"] = Builtins.shellcheck
    // Fork-owned scripts only; upstream scripts keep upstream style. Style: docs/s8/.editorconfig.
    ["shfmt"] = (Builtins.shfmt) {
        match_any = null
        glob = "docs/s8/*.sh"
    }
    // Also runs for a new or deleted note: the mdsmith block names the fork's READMEs.
    ["upstream_files"] {
        glob = List("**/*.md", ".mdsmith.yml", ".gitattributes", "docs/s8/upstream-files.*")
        stage = List(".mdsmith.yml", ".gitattributes", "docs/s8/upstream-files.txt")
        check = upstream_files_check
        fix = new CommandSpec {
            command = new Command {
                argv = List("docs/s8/upstream-files.sh")
            }
            effect = "write"
        }
    }
    // Fork-owned Markdown only. oxfmt formats; mdsmith lints.
    // The pinned oxfmt 0.76 has no --stdin-filepath, which the builtin's check_diff needs.
    ["oxfmt"] = (Builtins.oxfmt) {
        glob = "**/*.md"
        exclude = upstream_markdown
        check_diff = null
    }
    ["mdsmith"] {
        glob = List("**/*.md", ".mdsmith.yml")
        exclude = upstream_markdown
        depends = List("oxfmt", "upstream_files")
        stage = "*.md"
        env = mdsmith_env
        check = mdsmith_check
        fix = mdsmith_fix
    }
    // A deleted note matches no glob, so the steps above are skipped for it. hk stages
    // nothing for a step without files, so these only check.
    ["upstream_files_deleted"] {
        step_condition = #"any(git.staged_deleted_files, {hasSuffix(#, ".md")})"#
        depends = "upstream_files"
        check = upstream_files_check
    }
    ["mdsmith_deleted"] {
        step_condition = #"any(git.staged_deleted_files, {hasSuffix(#, ".md")})"#
        depends = "mdsmith"
        env = mdsmith_env
        check = mdsmith_check
    }
    // Upstream violations are grandfathered by the baseline; new violations fail.
    ["swiftlint"] {
        glob = "macos/**/*.swift"
        batch = true
        check = new CommandSpec {
            command = new Command {
                argv = List("swiftlint", "lint", "--strict", "--quiet", "--force-exclude", "--no-cache", "--baseline", ".swiftlint-baseline.json", "{{files}}")
            }
            effect = "read"
        }
    }
    // Formatting applies to fork-added Swift files; upstream files keep upstream style.
    ["swiftformat"] {
        glob = "macos/**/*.swift"
        exclude = List(
            "macos/BridgeController+Screens.swift",
            "macos/BridgeStatusMenu.swift",
            "macos/NIHardwareAgent.swift",
            "macos/NIHardwareAgentNative.swift",
            "macos/Package.swift",
            "macos/S4BridgeApp.swift",
            "macos/ScreenPreferences.swift",
            "macos/ScreenPrompts.swift",
            "macos/ScreenSettingsView.swift",
            "macos/ScreenSupport+Control.swift",
            "macos/ScreenSupport.swift",
            "macos/Tests/BridgeTests.swift",
            "macos/Tests/NIHardwareAgentNativeTests.swift",
            "macos/Tests/NIHardwareAgentTests.swift",
            "macos/Tests/ScreenControlTests.swift",
            "macos/Tests/ScreenMenuTests.swift",
            "macos/Tests/ScreenPreferencesTests.swift",
            "macos/Tests/ScreenProcessTests.swift",
            "macos/Tests/ScreenRestoreConfirmationTests.swift",
            "macos/Tests/ScreenStatusIconTests.swift",
            "macos/Tests/ScreenSupportTests.swift",
            "macos/Tests/ScreenTestSupport.swift"
        )
        batch = true
        check = new CommandSpec {
            command = new Command {
                argv = List("swiftformat", "--lint", "--quiet", "{{files}}")
            }
            effect = "read"
        }
        fix = new CommandSpec {
            command = new Command {
                argv = List("swiftformat", "--quiet", "{{files}}")
            }
            effect = "write"
        }
    }
    ["check_merge_conflict"] = Builtins.check_merge_conflict
}

// Checks never rewrite files. Commits and `hk fix` apply fixes; pre-commit stages
// them and keeps unstaged edits aside (hk stashes under refs/hk/stash, per worktree).
hooks {
    ["check"] {
        fix = false
        stage = false
        stash = "none"
    }
    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
    }
    ["fix"] {
        fix = true
        stage = false
        stash = "none"
    }
    // Merges, rebases and --no-verify commits skip pre-commit. The stash keeps
    // uncommitted and untracked notes out of the check.
    ["pre-push"] {
        stash = "git"
        steps {
            ["upstream_files"] {
                check = upstream_files_check
            }
            ["mdsmith"] {
                env = mdsmith_env
                check = mdsmith_check
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["check_conventional_commit"] = Builtins.check_conventional_commit
        }
    }
}
